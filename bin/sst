#!/usr/bin/env bash
set -u

_sst_usage() {
  cat <<'EOF'
Usage:
  sst open [ssh options] <host> <project>
  sst list [ssh options] <host>
  sst kill [ssh options] <host> <project>
  sst --help

Manage reconnectable remote tmux sessions over SSH.

  open   Create or attach to a named remote tmux session, reconnecting
         when a long-lived connection drops.
  list   List remote tmux sessions.
  kill   Kill one exact remote tmux session.

Project names must match [A-Za-z0-9][A-Za-z0-9_-]*.
SSH options are passed to ssh before the host. The host must be the only
positional argument; remote commands are rejected.
EOF
}

_sst_valid_project() {
  local name=${1-}
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]
}

# Validate an SSH argument vector before appending a fixed remote command.
# Accepts only options followed by exactly one destination.
_sst_validate_ssh() {
  local -a argv=("$@")
  local value_options='BbcDEeFIiJLlmOoPpQRSWw'
  local i=0 dest='' arg cluster ch value line
  local output

  while (( i < ${#argv[@]} )); do
    arg=${argv[i]}
    if [[ $arg == '--' ]]; then
      ((i++))
      while (( i < ${#argv[@]} )); do
        if [[ -n $dest ]]; then
          return 1
        fi
        dest=${argv[i]}
        ((i++))
      done
      break
    fi

    if [[ $arg == -* && $arg != - ]]; then
      cluster=${arg#-}
      local j=0
      while (( j < ${#cluster} )); do
        ch=${cluster:j:1}
        if [[ $value_options == *"$ch"* ]]; then
          if (( j + 1 < ${#cluster} )); then
            j=${#cluster}
          else
            ((i++))
            if (( i >= ${#argv[@]} )); then
              return 1
            fi
            value=${argv[i]}
            j=${#cluster}
          fi
        else
          ((j++))
        fi
      done
    else
      if [[ -n $dest ]]; then
        return 1
      fi
      dest=$arg
    fi
    ((i++))
  done

  [[ -n $dest ]] || return 1

  if ! output=$(command ssh -G "${argv[@]}" 2>/dev/null); then
    return 1
  fi

  while IFS= read -r line; do
    if [[ $line =~ ^remotecommand[[:space:]]+(.*)$ ]]; then
      value=${BASH_REMATCH[1]}
      if [[ $value != none ]]; then
        return 1
      fi
    fi
  done <<<"$output"

  return 0
}

_sst_error() {
  printf 'sst: %s\n' "$1" >&2
}

_sst_require_ssh() {
  if ! command -v ssh >/dev/null 2>&1; then
    _sst_error 'ssh not found in PATH; install an OpenSSH client'
    return 127
  fi
}

_sst_ssh() {
  command ssh "$@"
}

# Build the complete remote command from a validated project name.
_sst_remote_command() {
  local operation=$1 project=${2-} action
  case $operation in
    list) action='exec tmux list-sessions' ;;
    kill) action="exec tmux kill-session -t =$project" ;;
    open) action="exec tmux new-session -A -D -s $project" ;;
    *) return 1 ;;
  esac
  printf '%s\n' \
    "command -v tmux >/dev/null 2>&1 || { printf '%s\\n' 'sst: remote tmux not found; install tmux or add it to PATH' >&2; exit 127; }; $action"
}

_sst_cmd_list() {
  _sst_require_ssh || return 127
  if ! _sst_validate_ssh "$@"; then
    _sst_error 'invalid SSH arguments; supply options and exactly one host'
    return 2
  fi
  _sst_ssh -T "$@" "$(_sst_remote_command list)"
}

_sst_cmd_kill() {
  if (( $# < 2 )); then
    _sst_error 'kill requires a host and a project'
    return 2
  fi
  _sst_require_ssh || return 127
  local project=${!#}
  if ! _sst_valid_project "$project"; then
    _sst_error 'invalid project name; use letters, digits, _ and -, starting with a letter or digit'
    return 2
  fi
  local -a argv=("${@:1:$#-1}")
  if ! _sst_validate_ssh "${argv[@]}"; then
    _sst_error 'invalid SSH arguments; supply options and exactly one host'
    return 2
  fi
  _sst_ssh -T "${argv[@]}" "$(_sst_remote_command kill "$project")"
}

_sst_disarm() {
  printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1004l\033[?1049l\033[?25h'
}

_sst_open_session() {
  local -a argv=("${@:1:$#-1}")
  local project=${!#} remote started rc
  remote=$(_sst_remote_command open "$project")

  started=$SECONDS
  _sst_ssh -t "${argv[@]}" "$remote"
  rc=$?
  _sst_disarm

  if (( rc != 255 || SECONDS - started < 30 )); then
    return "$rc"
  fi

  _sst_error 'connection lost; reconnecting every 2 seconds'
  (
    while :; do
      sleep 2
      _sst_ssh -t "${argv[@]}" "$remote"
      rc=$?
      _sst_disarm
      (( rc == 255 )) || exit "$rc"
    done
  )
}

_sst_cmd_open() {
  if (( $# < 2 )); then
    _sst_error 'open requires a host and a project'
    return 2
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    _sst_error 'open requires an interactive terminal'
    return 2
  fi
  _sst_require_ssh || return 127
  local project=${!#}
  if ! _sst_valid_project "$project"; then
    _sst_error 'invalid project name; use letters, digits, _ and -, starting with a letter or digit'
    return 2
  fi
  local -a argv=("${@:1:$#-1}")
  if ! _sst_validate_ssh "${argv[@]}"; then
    _sst_error 'invalid SSH arguments; supply options and exactly one host'
    return 2
  fi
  _sst_open_session "${argv[@]}" "$project"
}

_sst_main() {
  local cmd=${1-}
  shift || true
  case $cmd in
    -h|--help) _sst_usage ;;
    open) _sst_cmd_open "$@" ;;
    list) _sst_cmd_list "$@" ;;
    kill) _sst_cmd_kill "$@" ;;
    '') _sst_usage >&2; return 2 ;;
    *) _sst_usage >&2; return 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  _sst_main "$@"
fi