#!/bin/bash
# Fake curl for sst update tests: serve files from FAKE_CURL_DIR.
set -euo pipefail

dest='' url='' arg=''
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  arg=${args[i]}
  case $arg in
    -o)
      i=$((i + 1))
      dest=${args[i]-}
      ;;
  esac
done
url=${args[${#args[@]}-1]-}

if [[ -n ${FAKE_CURL_LOG-} ]]; then
  printf '%s\n' "$*" >>"$FAKE_CURL_LOG"
fi

base=${url##*/}
if [[ ${FAKE_CURL_FAIL_ASSET-} == "$base" ]]; then
  exit 22
fi
if [[ -n ${FAKE_CURL_DIR-} && -f ${FAKE_CURL_DIR}/$base ]]; then
  cp "${FAKE_CURL_DIR}/$base" "$dest"
  exit 0
fi
exit 22